%0 : ptr<i32, Function> = $0(n)
scoped control:
    scope ^0(entry): [^1(exit) forward owner=^0(entry), ^2(header) forward owner=^0(entry)]
    scope ^1(exit): []
    scope ^2(header): [^1(exit) forward owner=^0(entry), ^2(header) repeat owner=^2(header), ^3(step) forward owner=^2(header)]
    scope ^3(step): [^1(exit) forward owner=^0(entry), ^2(header) repeat owner=^2(header)]
    transfer ^0(entry)#0 -> ^2(header) forward owner=^0(entry)
    transfer ^2(header)#0 -> ^3(step) forward owner=^2(header)
    transfer ^2(header)#1 -> ^1(exit) forward owner=^0(entry)
    transfer ^3(step)#0 -> ^2(header) repeat owner=^2(header)

block ^0(entry):
    block ^1(exit):

        |=> postdom function-exit finite
        %1 : i32 = region $0

        return %1 : i32

    loop ^2(header) | break -> <not recorded> :
        block ^3(step):

            |=> postdom ^2(header) may-diverge
            %2 : i32 = region $0
            %3 : i32 = region $1
            %4 : i32 = region $2

            %5 : i32 = add.i32  (%2 : i32) (%3 : i32)
            %6 : i32 = add.i32  (%3 : i32) (1_i32)
            br ^2(header)(%5 : i32, %6 : i32, %4 : i32)


        |=> postdom ^1(exit) may-diverge
        %7 : i32 = region $0
        %8 : i32 = region $1
        %9 : i32 = region $2

        %10 : bool = lt.i32  (%8 : i32) (%9 : i32)
        br_if %10 : bool
            ^3(step)(%7 : i32, %8 : i32, %9 : i32)
        else
            ^1(exit)(%7 : i32)


    |=> postdom ^2(header) may-diverge

    %11 : i32 = load  (%0 : ptr<i32, Function>)
    br ^2(header)(0_i32, 0_i32, %11 : i32)
