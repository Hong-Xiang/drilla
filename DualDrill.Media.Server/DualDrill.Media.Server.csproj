<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1506</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GstSharp.Net" VersionOverride="1.28.13" />
    <PackageReference Include="GstSharp.Net.App" VersionOverride="1.28.13" />
    <PackageReference Include="GstSharp.Net.Sdp" VersionOverride="1.28.13" />
    <PackageReference Include="GstSharp.Net.WebRTC" VersionOverride="1.28.13" />
  </ItemGroup>

</Project>
