<Project Sdk="Microsoft.Build.NoTargets/3.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <SourceFiles Include="src\**\*.ts" />
    <SourceFiles Include="src\**\*.tsx" />
    <SourceFiles Include="esbuild.mjs" />
    <SourceFiles Include="package.json" />
    <SourceFiles Include="bun.lock" />
  </ItemGroup>

  <Target Name="BunRestore" AfterTargets="Restore">
    <Exec Command="bun install --frozen-lockfile" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="Build"
          Inputs="@(SourceFiles)"
          Outputs="$(MSBuildProjectDirectory)\node_modules\.build.stamp">
    <Exec Command="bun run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(MSBuildProjectDirectory)\node_modules\.build.stamp" AlwaysCreate="true" />
  </Target>
</Project>