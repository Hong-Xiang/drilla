<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup>
		<!-- Workaround for issue https://github.com/microsoft/ClangSharp/issues/129 -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(PackAsTool)' != 'true'">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
	</PropertyGroup>

	<Target Name="PreBuild" BeforeTargets="Build">
		<Exec Command="echo Running pnpm install" />
		<Exec Command="pnpm install" WorkingDirectory="..\DualDrill.JS" />
		<Exec Command="echo running node .\esbuild.mjs" />
		<Exec Command="node .\esbuild.mjs" WorkingDirectory="..\DualDrill.JS" />
	</Target>

	<ItemGroup>
		<PackageReference Include="DuckDB.NET.Data.Full" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="Swashbuckle.AspNetCore" />
		<ProjectReference Include="..\DualDrill.APIDefinition\DualDrill.ApiGen.csproj" />
		<ProjectReference Include="..\DualDrill.Common\DualDrill.Common.csproj" />
		<ProjectReference Include="..\DualDrill.Engine\DualDrill.Engine.csproj" />
		<ProjectReference Include="..\DualDrill.Graphics\DualDrill.Graphics.csproj" />
		<ProjectReference Include="..\DualDrill.ILSL\DualDrill.ILSL.csproj" />
		<ProjectReference Include="..\DualDrill.Shaders\DualDrill.Shaders.csproj" />
		<PackageReference Update="DotNext.Unsafe" />
		<PackageReference Update="Silk.NET" />
		<PackageReference Update="Silk.NET.Core" />
		<PackageReference Update="Silk.NET.Input" />
		<PackageReference Update="Silk.NET.Shaderc" />
		<PackageReference Update="Silk.NET.Shaderc.Native" />
		<PackageReference Update="Silk.NET.Vulkan" />
		<PackageReference Update="Silk.NET.Vulkan.Extensions.EXT" />
		<PackageReference Update="Silk.NET.Windowing" />
	</ItemGroup>
</Project>